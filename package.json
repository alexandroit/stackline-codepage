{
  "name": "@stackline/codepage",
  "version": "1.0.0",
  "author": "SheetJS",
  "description": "pure-JS library to handle codepages",
  "keywords": [
    "codepage",
    "iconv",
    "convert",
    "strings"
  ],
  "main": "cputils.js",
  "types": "types",
  "browser": {
    "buffer": false
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandroit/stackline-codepage.git"
  },
  "scripts": {
    "test": "node --test test-stackline/*.test.cjs",
    "lint": "node scripts/check-syntax.cjs",
    "build": "node scripts/build.cjs",
    "test:types": "node scripts/check-types.cjs",
    "test:package": "node scripts/package-smoke.cjs"
  },
  "homepage": "https://github.com/alexandroit/stackline-codepage",
  "files": [
    "LICENSE",
    "README.md",
    "bin",
    "bits/*.js",
    "types/index.d.ts",
    "types/*.json",
    "cptable.js",
    "cputils.js",
    "dist/sbcs.full.js",
    "dist/cpexcel.full.js",
    "NOTICE",
    "UPSTREAM.json",
    "CHANGELOG.md"
  ],
  "bugs": {
    "url": "https://github.com/alexandroit/stackline-codepage/issues"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=0.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {}
}
